@{
    ViewBag.Title = "Inicio";
}

<div class="jumbotron text-center">
    <h1>Bienvenidos a la Dulcería</h1>
    <p class="lead">Los mejores dulces y golosinas para todos los gustos</p>
</div>

<h2 class="text-center" style="margin-bottom: 30px;">Productos Destacados</h2>

<div class="row">
    <!-- Galletas -->
    <div class="col-md-4">
        <div class="panel panel-default">
            <div class="panel-heading text-center">
                <h3 class="panel-title">Galletas de Chocolate</h3>
            </div>
            <div class="panel-body text-center">
                <img src="~/Content/Images/Galletascholate.png" alt="Galletas" class="img-responsive center-block" style="max-height:200px;" />
                <div class="caption">
                    <p>Deliciosas galletas con trozos de chocolate.</p>
                    <p><strong>Precio: </strong>$2.50</p>
                    <p>
                        <a href="#" class="btn btn-primary">Ver Detalles</a>
                        <a href="#" class="btn btn-success">Agregar al Carrito</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Brownie -->
    <div class="col-md-4">
        <div class="panel panel-default">
            <div class="panel-heading text-center">
                <h3 class="panel-title">Brownie</h3>
            </div>
            <div class="panel-body text-center">
                <img src="~/Content/Images/Brownie.jpg" alt="Brownie" class="img-responsive center-block" style="max-height:200px;" />
                <div class="caption">
                    <p>Brownie húmedo de chocolate con nueces.</p>
                    <p><strong>Precio: </strong>$2.50</p>
                    <p>
                        <a href="#" class="btn btn-primary">Ver Detalles</a>
                        <a href="#" class="btn btn-success">Agregar al Carrito</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Flan -->
    <div class="col-md-4">
        <div class="panel panel-default">
            <div class="panel-heading text-center">
                <h3 class="panel-title">Flan Casero</h3>
            </div>
            <div class="panel-body text-center">
                <img src="~/Content/Images/Flan.png" alt="Flan" class="img-responsive center-block" style="max-height:200px;" />
                <div class="caption">
                    <p>Suave flan con cobertura de caramelo.</p>
                    <p><strong>Precio: </strong>$3.50</p>
                    <p>
                        <a href="#" class="btn btn-primary">Ver Detalles</a>
                        <a href="#" class="btn btn-success">Agregar al Carrito</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>